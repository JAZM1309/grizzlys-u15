rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "q6AID4Wkp2arQlCTROTKqON6ckk2";
    }

    // EHV-Abgleich: nur der Admin liest; schreiben darf er nur die Liste der abgelehnten Abweichungen
    match /ehvSync/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && docId == "dismissed"
        && request.resource.data.keys().hasOnly(["keys","updatedAt"])
        && request.resource.data["keys"] is list
        && request.resource.data["keys"].size() <= 200;
    }

    match /results/{resultId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Live-Ticker (1.26.0): für alle lesbar, geschrieben wird nur von der Cloud Function liveTicker
    match /live/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Fan-Tipp (1.28.0): anonym, ein Tipp je Gerät und Spiel (Dokument-ID = Spiel-ID__Geräte-ID).
    // Einzelne Tipps liest nur der Admin; alle sehen die Zusammenfassung in fanTipStats.
    match /fanTips/{tipId} {
      allow create, update: if request.resource.data.keys().hasOnly(["gameId","team","hs","as","g","createdAt"])
        && request.resource.data.gameId is string
        && request.resource.data.gameId.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}_(A|B|U13)")
        && tipId.matches(request.resource.data.gameId + "__[A-Za-z0-9_-]{8,64}")
        && request.resource.data.team in ["A","B","U13"]
        && request.resource.data.g in ["h","a"]
        && request.resource.data.hs is int && request.resource.data.hs >= 0 && request.resource.data.hs <= 40
        && request.resource.data.as is int && request.resource.data.as >= 0 && request.resource.data.as <= 40
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }
    match /fanTipStats/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Helferdienste (1.70.0): je Heimspiel Einträge mit frei gewähltem Namen. Eintragen mit (anonymer) Anmeldung,
    // löschen darf nur, wer eingetragen hat (gleiche uid), oder der Admin. helpersTest = Test-App.
    function helperEntryOk() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(["gid","gd","team","item","name","uid","createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.gid is string
        && request.resource.data.gid.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}_(A|B|U13|U17)")
        && request.resource.data.gd is string && request.resource.data.gd.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
        && request.resource.data.team in ["A","B","U13","U17"]
        && request.resource.data.item is string && request.resource.data.item.matches("[a-z0-9]{1,20}")
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time;
    }
    match /helpers/{id} {
      allow read: if true;
      allow create: if helperEntryOk();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if false;
    }
    match /helpersTest/{id} {
      allow read: if true;
      allow create: if helperEntryOk();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if false;
    }
    match /helperCfg/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId in ["template","games"];
    }

    match /scheduleOverrides/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Wetter am Spielort (1.43.0): schreibt nur die Cloud Function weatherForecast
    match /weather/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Spruch des Tages (1.41.0), Wunschliste (1.44.0) und Kapitäne (1.45.0): für alle lesbar, nur der Admin schreibt
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId in ["sprueche","wuensche","kapitaene"]
        && request.resource.data.keys().hasOnly(["on","list","updatedAt"])
        && request.resource.data.on is bool
        && request.resource.data["list"] is list
        && request.resource.data["list"].size() <= 400;
    }

    // Ein-Tipp-Feedback (1.44.0): 👍/👎 je Gerät und Ziel (Spielbericht „rep_…“, „Neu in der App“ „neu_…“), anonym
    match /reactions/{rid} {
      allow create, update: if request.resource.data.keys().hasOnly(["target","v","createdAt"])
        && request.resource.data.target is string
        && request.resource.data.target.matches("(rep|neu)_[A-Za-z0-9._-]{3,60}")
        && rid.matches(request.resource.data.target + "__[A-Za-z0-9_-]{8,64}")
        && request.resource.data.v in [1, -1]
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }
    match /reactionStats/{target} {
      allow read: if true;
      allow write: if false;
    }
    // Wunschliste (1.44.0): bis zu 3 Stimmen je Gerät, anonym
    match /wishVotes/{deviceId} {
      allow create, update: if deviceId.matches("[A-Za-z0-9_-]{8,64}")
        && request.resource.data.keys().hasOnly(["v","updatedAt"])
        && request.resource.data.v is list && request.resource.data.v.size() <= 3
        && request.resource.data.updatedAt == request.time;
      allow read, delete: if isAdmin();
    }
    match /wishStats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // News-Hinweise aus dem Adminbereich (für alle lesbar, nur Admin schreibt)
    match /news/{newsId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["title","text","team","until","push","createdAt"])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.team in ["", "A", "B", "U13"]
        && request.resource.data.until is string && request.resource.data.until.size() <= 10
        && request.resource.data.push is bool;
      allow update, delete: if isAdmin();
    }

    match /pushTokens/{tokenId} {
      allow create, update: if request.resource.data.token == tokenId
        && tokenId.size() < 600
        && request.resource.data.keys().hasOnly(
             ["token","installationId","createdAt","updatedAt","platform","admin","adminUid","prefs","app","ver"])
        && (request.resource.data.get("admin", false) != true || isAdmin())
        && (request.resource.data.get("adminUid", null) == null || isAdmin());
      allow read, delete: if isAdmin();
    }

    match /appInstallations/{installationId} {
      allow create, update: if request.resource.data.installationId == installationId
        && installationId.size() <= 80
        && request.resource.data.keys().hasOnly(
             ["installationId","platform","userAgent","pushEnabled","pushRegisteredAt","createdAt","updatedAt"])
        && request.resource.data.get("userAgent", "").size() <= 500;
      allow read, delete: if isAdmin();
    }

    match /bugReports/{reportId} {
      allow create: if
        request.resource.data.status == "Neu"
        && request.resource.data.keys().hasOnly(
             ["type","name","area","description","contact","appVersion","platform","userAgent",
              "pushRegistered","createdAt","status"])
        && request.resource.data.get("type", "Fehler") in ["Fehler","Wunsch / Anregung","Lob"]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5 && request.resource.data.description.size() <= 2000
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20
        && request.resource.data.get("area", "Sonstiges").size() <= 40
        && request.resource.data.get("contact", "").size() <= 200
        && request.resource.data.get("userAgent", "").size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Adventskalender: jedes Gerät überträgt je Türchen nur Fragenart und richtig/falsch; nur der Admin liest
    match /adventAnswers/{docId} {
      allow create, update: if request.resource.data.id == docId
        && docId.size() <= 100
        && request.resource.data.keys().hasOnly(["id","year","answers","updatedAt"])
        && request.resource.data.year is int
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 24;
      allow read, delete: if isAdmin();
    }

    // Spielberichte (1.9.1.129; 1.39.1: Feld bausteine für die automatischen Berichte): veröffentlichte für alle lesbar, Entwürfe nur für den Admin
    match /reports/{reportId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["gameId","team","date","title","text","keywords","use","len","bausteine","published","publishedAt","updatedAt"])
        && (request.resource.data.get("bausteine", null) == null || request.resource.data.get("bausteine", null) is map || request.resource.data.get("bausteine", null) is list)
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.get("keywords", "") is string && request.resource.data.get("keywords", "").size() <= 200
        && request.resource.data.get("use", {}) is map && request.resource.data.get("use", {}).size() <= 30
        && request.resource.data.get("len", "") in ["", "kurz"]
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }

    // Fehlerzählung der App (1.40.0): anonym, nur Fehlertext/Datei/Zeile/Version/Gerätetyp; nur der Admin liest
    match /appErrors/{errId} {
      allow create, update: if errId.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]{4,12}")
        && request.resource.data.keys().hasOnly(["day","msg","src","v","n","last","plat"])
        && request.resource.data.day == errId.split("_")[0]
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 160
        && request.resource.data.get("src", "") is string && request.resource.data.get("src", "").size() <= 100
        && request.resource.data.get("v", "") is string && request.resource.data.get("v", "").size() <= 20
        && request.resource.data.get("plat", "desktop") in ["android","ios","desktop"]
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 5000
        && request.resource.data.last == request.time;
      allow read, delete: if isAdmin();
    }

    match /gameReminders/{reminderId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
