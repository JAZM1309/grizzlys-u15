rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "q6AID4Wkp2arQlCTROTKqON6ckk2";
    }

    // EHV-Abgleich: nur der Admin liest; schreiben darf er nur die Liste der abgelehnten Abweichungen
    match /ehvSync/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && docId == "dismissed"
        && request.resource.data.keys().hasOnly(["keys","updatedAt"])
        && request.resource.data["keys"] is list
        && request.resource.data["keys"].size() <= 200;
    }

    match /results/{resultId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /scheduleOverrides/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // News-Hinweise aus dem Adminbereich (für alle lesbar, nur Admin schreibt)
    match /news/{newsId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["title","text","team","until","push","createdAt"])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.team in ["", "A", "B"]
        && request.resource.data.until is string && request.resource.data.until.size() <= 10
        && request.resource.data.push is bool;
      allow update, delete: if isAdmin();
    }

    match /pushTokens/{tokenId} {
      allow create, update: if request.resource.data.token == tokenId
        && tokenId.size() < 600
        && request.resource.data.keys().hasOnly(
             ["token","installationId","createdAt","updatedAt","platform","admin","adminUid","prefs"])
        && (request.resource.data.get("admin", false) != true || isAdmin())
        && (request.resource.data.get("adminUid", null) == null || isAdmin());
      allow read, delete: if isAdmin();
    }

    match /appInstallations/{installationId} {
      allow create, update: if request.resource.data.installationId == installationId
        && installationId.size() <= 80
        && request.resource.data.keys().hasOnly(
             ["installationId","platform","userAgent","pushEnabled","pushRegisteredAt","createdAt","updatedAt"])
        && request.resource.data.get("userAgent", "").size() <= 500;
      allow read, delete: if isAdmin();
    }

    match /bugReports/{reportId} {
      allow create: if
        request.resource.data.status == "Neu"
        && request.resource.data.keys().hasOnly(
             ["type","name","area","description","contact","appVersion","platform","userAgent",
              "pushRegistered","createdAt","status"])
        && request.resource.data.get("type", "Fehler") in ["Fehler","Wunsch / Anregung","Lob"]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5 && request.resource.data.description.size() <= 2000
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20
        && request.resource.data.get("area", "Sonstiges").size() <= 40
        && request.resource.data.get("contact", "").size() <= 200
        && request.resource.data.get("userAgent", "").size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Adventskalender: jedes Gerät überträgt je Türchen nur Fragenart und richtig/falsch; nur der Admin liest
    match /adventAnswers/{docId} {
      allow create, update: if request.resource.data.id == docId
        && docId.size() <= 100
        && request.resource.data.keys().hasOnly(["id","year","answers","updatedAt"])
        && request.resource.data.year is int
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 24;
      allow read, delete: if isAdmin();
    }

    // Spielberichte (1.9.1.129): veröffentlichte für alle lesbar, Entwürfe nur für den Admin
    match /reports/{reportId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["gameId","team","date","title","text","keywords","use","len","published","publishedAt","updatedAt"])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.get("keywords", "") is string && request.resource.data.get("keywords", "").size() <= 200
        && request.resource.data.get("use", {}) is map && request.resource.data.get("use", {}).size() <= 30
        && request.resource.data.get("len", "") in ["", "kurz"]
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }

    match /gameReminders/{reminderId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
