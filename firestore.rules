rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "q6AID4Wkp2arQlCTROTKqON6ckk2";
    }

    match /results/{resultId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /scheduleOverrides/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pushTokens/{tokenId} {
      allow create, update: if request.resource.data.token == tokenId
        && tokenId.size() < 600
        && request.resource.data.keys().hasOnly(
             ["token","installationId","createdAt","updatedAt","platform","admin","adminUid"])
        && (request.resource.data.get("admin", false) != true || isAdmin())
        && (request.resource.data.get("adminUid", null) == null || isAdmin());
      allow read, delete: if isAdmin();
    }

    match /appInstallations/{installationId} {
      allow create, update: if request.resource.data.installationId == installationId
        && installationId.size() <= 80
        && request.resource.data.keys().hasOnly(
             ["installationId","platform","userAgent","pushEnabled","pushRegisteredAt","createdAt","updatedAt"])
        && request.resource.data.get("userAgent", "").size() <= 500;
      allow read, delete: if isAdmin();
    }

    match /bugReports/{reportId} {
      allow create: if
        request.resource.data.status == "Neu"
        && request.resource.data.keys().hasOnly(
             ["type","name","area","description","contact","appVersion","platform","userAgent",
              "pushRegistered","createdAt","status"])
        && request.resource.data.get("type", "Fehler") in ["Fehler","Wunsch / Anregung","Lob"]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5 && request.resource.data.description.size() <= 2000
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20
        && request.resource.data.get("area", "Sonstiges").size() <= 40
        && request.resource.data.get("contact", "").size() <= 200
        && request.resource.data.get("userAgent", "").size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /gameReminders/{reminderId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
